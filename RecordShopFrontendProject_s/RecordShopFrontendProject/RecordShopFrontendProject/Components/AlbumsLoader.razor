@using RecordShopFrontendProject.Models
@using System.Text.Json.Serialization
@rendermode InteractiveWebAssembly

@page "/AlbumLoader"
<h3>AlbumsLoader</h3>

@if (_albumsFromApi != null) {
<AlbumsSummaryList Albums="_albumsFromApi" />
}
else {
<h3> Could not load albums</h3>
<p>@errorCode</p>
}

@code {
    private List<Album> _albumsFromApi { get; set; } = new();
    private string? errorCode { get; set; } = string.Empty;
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = new HttpClient();
            var json = await client.GetFromJsonAsync<List<Album>>("https://localhost:7100/api/Album");
            if (json != null)
            {
                json.ForEach((a) => Console.WriteLine(a.Title));
                _albumsFromApi = json;
            }
        }
        catch (Exception e)
        {
            Console.WriteLine(e.Message);
            errorCode = e.Message;
        }
    }
}